generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  landscape
  street
  documentary
  portrait
  commercial
}

model Project {
  id             String    @id @default(uuid())
  slug           String    @unique
  title          String
  subtitle       String?
  year           Int
  location       String?
  category       Category?
  coverSrc       String
  coverAlt       String?
  description    String?
  dateRangeStart String?
  dateRangeEnd   String?
  published      Boolean   @default(false)
  publishedAt    DateTime?
  photos         Photo[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Photo {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  src        String
  thumbSrc   String?
  width      Int?
  height     Int?
  title      String?
  caption    String?
  year       Int?
  location   String?
  takenAt    String?
  order      Int
  hidden     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
